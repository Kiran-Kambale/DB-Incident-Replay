# PostgreSQL connection. Use a dedicated monitoring account where possible.
# Example for local Homebrew PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/incident_lab

# Collector behaviour
COLLECT_INTERVAL_SECONDS=10
LONG_QUERY_SECONDS=30
IDLE_TRANSACTION_SECONDS=60
CONNECTION_WARNING_PCT=80
CONNECTION_CRITICAL_PCT=95
REPLICATION_LAG_WARNING_BYTES=104857600

# Privacy: SQL text is NOT stored unless you explicitly enable it.
CAPTURE_QUERY_TEXT=false

# Optional pg_stat_statements sampling. Requires extension and SELECT permission.
ENABLE_PG_STAT_STATEMENTS=false

# Local evidence store (SQLite). This is separate from your PostgreSQL database.
EVIDENCE_DB_PATH=./data/incident_intelligence.sqlite3
