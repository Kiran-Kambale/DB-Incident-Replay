# Copy this file to .env and change the values to match your LOCAL PostgreSQL installation.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=incident_lab
DB_USER=incident_reader
DB_PASSWORD=change_this_local_password

# Automatic local sampling (v0.4)
AUTO_MONITOR=true
MONITOR_INTERVAL_SECONDS=15
LONG_QUERY_SECONDS=30
IDLE_TXN_SECONDS=60

# Optional: absolute path to PostgreSQL active log if auto-discovery is unavailable
# PG_LOG_FILE=/opt/homebrew/var/postgresql@17/log/postgresql-current.log
